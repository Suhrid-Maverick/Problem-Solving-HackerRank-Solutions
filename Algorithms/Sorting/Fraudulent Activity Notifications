import java.io.*;
import java.util.*;

public class Solution {
    public static void main(String[] args) throws IOException {
        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
        StringTokenizer st = new StringTokenizer(br.readLine());
        int n = Integer.parseInt(st.nextToken());
        int d = Integer.parseInt(st.nextToken());

        int[] exp = new int[n];
        st = new StringTokenizer(br.readLine());
        for (int i = 0; i < n; i++) {
            exp[i] = Integer.parseInt(st.nextToken());
        }

        int[] freq = new int[201];
        for (int i = 0; i < d; i++) {
            freq[exp[i]]++;
        }

        int notices = 0;

        for (int i = d; i < n; i++) {
            int medianSum;

            if ((d & 1) == 1) {
                int pos = d / 2 + 1;
                int count = 0;
                int med = 0;
                for (int v = 0; v <= 200; v++) {
                    count += freq[v];
                    if (count >= pos) {
                        med = v;
                        break;
                    }
                }
                medianSum = 2 * med;
            } else {
                int pos1 = d / 2;
                int pos2 = d / 2 + 1;
                int count = 0;
                int med1 = 0, med2 = 0;
                for (int v = 0; v <= 200; v++) {
                    count += freq[v];
                    if (count >= pos1 && med1 == 0) {
                        med1 = v;
                    }
                    if (count >= pos2) {
                        med2 = v;
                        break;
                    }
                }
                medianSum = med1 + med2;
            }

            if (exp[i] >= medianSum) {
                notices++;
            }

            freq[exp[i - d]]--;
            freq[exp[i]]++;
        }

        System.out.println(notices);
    }
}
