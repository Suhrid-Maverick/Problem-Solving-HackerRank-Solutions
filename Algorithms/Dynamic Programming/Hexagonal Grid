import java.util.Scanner;

public class Solution {

    static boolean isBlocked(int n, int[] first, int[] second) {
        int blockedCells = 0;
        for (int i = 0; i < n; i++) {
            blockedCells += first[i] + second[i];
        }
        if (blockedCells % 2 == 1) {
            return true;
        }
        if (blockedCells == 2 * n) {
            return false;
        }
        int sumSoFar = 0;
        for (int i = 0; i < n; i++) {
            sumSoFar += (1 - first[i]);
            if (i > 0 && first[i] == 1 && second[i - 1] == 1) {
                if (sumSoFar % 2 == 1) {
                    return true;
                }
                sumSoFar = 0;
            }
            if (first[i] == 1 && second[i] == 1 && sumSoFar % 2 == 1) {
                return true;
            }
            sumSoFar += (1 - second[i]);
        }
        return false;
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int T = Integer.parseInt(sc.nextLine().trim());
        for (int t = 0; t < T; t++) {
            int n = Integer.parseInt(sc.nextLine().trim());
            String line1 = sc.nextLine().trim();
            String line2 = sc.nextLine().trim();
            int[] first = new int[n];
            int[] second = new int[n];
            for (int i = 0; i < n; i++) {
                first[i] = line1.charAt(i) - '0';
                second[i] = line2.charAt(i) - '0';
            }
            if (isBlocked(n, first, second)) {
                System.out.println("NO");
            } else {
                System.out.println("YES");
            }
        }
        sc.close();
    }
}
