import java.io.*;
import java.util.*;

public class Solution {

    public static void main(String[] args) throws IOException {
        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
        int g = Integer.parseInt(br.readLine().trim());
        StringBuilder sb = new StringBuilder();

        while (g-- > 0) {
            StringTokenizer st = new StringTokenizer(br.readLine());
            long n = Long.parseLong(st.nextToken());
            long m = Long.parseLong(st.nextToken());
            long s = Long.parseLong(st.nextToken());
            sb.append(minimumWeight(n, m, s)).append('\n');
        }

        System.out.print(sb);
    }

    private static long minimumWeight(long n, long m, long s) {
        // For n = 2 there is only one possible edge
        if (n == 2) {
            return s;
        }

        // n2 is the number of edges in a "star plus all leaf-leaf edges" graph
        long n2 = (n * n - 3 * n + 4) / 2;

        // If the graph is sparse enough, the optimal MST is a path
        if (m <= n2) {
            return m + s - n + 1;
        }

        // Otherwise three candidate strategies are compared
        long core = (n - 1) * (n - 2) / 2;

        // Strategy 1: Unbalanced (one very large MST edge, rest small)
        long unbalanced = core + (s - n + 2) * (m - core);

        // Strategy 2: Balanced (all MST edges as equal as possible)
        long base = s / (n - 1);
        long larger = s - base * (n - 1);
        long smaller = n - 1 - larger;

        long midbalanced = base * core + (base + larger) * (m - core);

        long balanced;
        if (larger > 0) {
            core = smaller * (smaller + 1) / 2;
            balanced = base * core + (base + 1) * (m - core);
        } else {
            balanced = base * m;
        }

        return Math.min(Math.min(unbalanced, balanced), midbalanced);
    }
}
