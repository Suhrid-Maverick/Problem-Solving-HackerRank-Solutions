import java.io.*;
import java.util.*;

public class Solution {

    static int[] dx = {-1, 0, 1, 0};
    static int[] dy = {0, -1, 0, 1};

    public static void main(String[] args) throws IOException {
        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
        StringTokenizer st = new StringTokenizer(br.readLine());
        int n = Integer.parseInt(st.nextToken());
        int m = Integer.parseInt(st.nextToken());
        int k = Integer.parseInt(st.nextToken());

        char[][] grid = new char[n][m];
        for (int i = 0; i < n; i++) {
            grid[i] = br.readLine().trim().toCharArray();
        }

        int[][][] tunnel = new int[n][m][];
        for (int i = 0; i < k; i++) {
            st = new StringTokenizer(br.readLine());
            int r1 = Integer.parseInt(st.nextToken()) - 1;
            int c1 = Integer.parseInt(st.nextToken()) - 1;
            int r2 = Integer.parseInt(st.nextToken()) - 1;
            int c2 = Integer.parseInt(st.nextToken()) - 1;
            tunnel[r1][c1] = new int[]{r2, c2};
            tunnel[r2][c2] = new int[]{r1, c1};
        }

        int N = n * m;
        double[][] mat = new double[N][N + 1];

        int startR = 0, startC = 0;

        for (int i = 0; i < n; i++) {
            for (int j = 0; j < m; j++) {
                int idx = i * m + j;
                mat[idx][idx] = 1.0;

                char ch = grid[i][j];
                if (ch == '%') {
                    mat[idx][N] = 1.0;
                    continue;
                }
                if (ch == '*' || ch == '#') {
                    mat[idx][N] = 0.0;
                    continue;
                }
                if (ch == 'A') {
                    startR = i;
                    startC = j;
                }

                int avail = 0;
                for (int d = 0; d < 4; d++) {
                    int ni = i + dx[d];
                    int nj = j + dy[d];
                    if (ni >= 0 && ni < n && nj >= 0 && nj < m && grid[ni][nj] != '#') {
                        avail++;
                    }
                }

                for (int d = 0; d < 4; d++) {
                    int ni = i + dx[d];
                    int nj = j + dy[d];
                    if (ni >= 0 && ni < n && nj >= 0 && nj < m && grid[ni][nj] != '#') {
                        if (tunnel[ni][nj] != null) {
                            int[] t = tunnel[ni][nj];
                            ni = t[0];
                            nj = t[1];
                        }
                        mat[idx][ni * m + nj] -= 1.0 / avail;
                    }
                }
            }
        }

        gaussianElimination(mat, N);

        int startIdx = startR * m + startC;
        System.out.printf("%.10f\n", mat[startIdx][N]);
    }

    static void gaussianElimination(double[][] a, int n) {
        for (int col = 0, row = 0; col < n && row < n; col++, row++) {
            int pivot = row;
            for (int i = row + 1; i < n; i++) {
                if (Math.abs(a[i][col]) > Math.abs(a[pivot][col])) {
                    pivot = i;
                }
            }

            double[] temp = a[row];
            a[row] = a[pivot];
            a[pivot] = temp;

            double div = a[row][col];
            if (Math.abs(div) < 1e-12) continue;

            for (int j = col; j <= n; j++) {
                a[row][j] /= div;
            }

            for (int i = 0; i < n; i++) {
                if (i != row && Math.abs(a[i][col]) > 1e-12) {
                    double factor = a[i][col];
                    for (int j = col; j <= n; j++) {
                        a[i][j] -= factor * a[row][j];
                    }
                }
            }
        }
    }
}
