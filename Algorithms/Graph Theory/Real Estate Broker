import java.io.*;
import java.util.*;

public class Solution {
    static int n, m;
    static ArrayList<Integer>[] adj;
    static int[] matchL, matchR, dist;
    static final int INF = Integer.MAX_VALUE;

    public static void main(String[] args) throws IOException {
        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
        BufferedWriter bw = new BufferedWriter(new OutputStreamWriter(System.out));

        StringTokenizer st = new StringTokenizer(br.readLine());
        n = Integer.parseInt(st.nextToken());
        m = Integer.parseInt(st.nextToken());

        int[] a = new int[n], p = new int[n];
        for (int i = 0; i < n; i++) {
            st = new StringTokenizer(br.readLine());
            a[i] = Integer.parseInt(st.nextToken());
            p[i] = Integer.parseInt(st.nextToken());
        }

        int[] x = new int[m], y = new int[m];
        for (int j = 0; j < m; j++) {
            st = new StringTokenizer(br.readLine());
            x[j] = Integer.parseInt(st.nextToken());
            y[j] = Integer.parseInt(st.nextToken());
        }

        // Build bipartite graph: client i -> house j if x[j] > a[i] and y[j] <= p[i]
        adj = new ArrayList[n];
        for (int i = 0; i < n; i++) {
            adj[i] = new ArrayList<>();
            for (int j = 0; j < m; j++) {
                if (x[j] > a[i] && y[j] <= p[i]) {
                    adj[i].add(j);
                }
            }
        }

        matchL = new int[n];
        matchR = new int[m];
        dist = new int[n];
        Arrays.fill(matchL, -1);
        Arrays.fill(matchR, -1);

        int matching = 0;
        while (bfs()) {
            for (int i = 0; i < n; i++) {
                if (matchL[i] == -1 && dfs(i)) {
                    matching++;
                }
            }
        }

        bw.write(matching + "\n");
        bw.flush();
    }

    // BFS to find augmenting paths
    static boolean bfs() {
        ArrayDeque<Integer> queue = new ArrayDeque<>();
        for (int i = 0; i < n; i++) {
            if (matchL[i] == -1) {
                dist[i] = 0;
                queue.add(i);
            } else {
                dist[i] = INF;
            }
        }
        boolean found = false;
        while (!queue.isEmpty()) {
            int u = queue.poll();
            for (int v : adj[u]) {
                int w = matchR[v];
                if (w == -1) {
                    found = true;
                } else if (dist[w] == INF) {
                    dist[w] = dist[u] + 1;
                    queue.add(w);
                }
            }
        }
        return found;
    }

    // DFS to augment matching
    static boolean dfs(int u) {
        for (int v : adj[u]) {
            int w = matchR[v];
            if (w == -1 || (dist[w] == dist[u] + 1 && dfs(w))) {
                matchL[u] = v;
                matchR[v] = u;
                return true;
            }
        }
        dist[u] = INF;
        return false;
    }
}
