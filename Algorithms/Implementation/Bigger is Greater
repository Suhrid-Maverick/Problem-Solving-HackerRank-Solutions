import java.io.*;

public class Solution {
    public static void main(String[] args) throws IOException {
        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
        int t = Integer.parseInt(br.readLine().trim());
        StringBuilder sb = new StringBuilder();

        while (t-- > 0) {
            char[] w = br.readLine().trim().toCharArray();
            int n = w.length;

            int i = n - 2;
            while (i >= 0 && w[i] >= w[i + 1]) {
                i--;
            }

            if (i < 0) {
                sb.append("no answer\n");
                continue;
            }

            int j = n - 1;
            while (w[j] <= w[i]) {
                j--;
            }

            char temp = w[i];
            w[i] = w[j];
            w[j] = temp;

            int left = i + 1;
            int right = n - 1;
            while (left < right) {
                temp = w[left];
                w[left] = w[right];
                w[right] = temp;
                left++;
                right--;
            }

            sb.append(new String(w)).append('\n');
        }

        System.out.print(sb);
    }
}
