import java.io.*;
import java.util.*;

public class Solution {
    public static void main(String[] args) throws IOException {
        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
        int t = Integer.parseInt(br.readLine().trim());
        StringBuilder sb = new StringBuilder();

        while (t-- > 0) {
            int n = Integer.parseInt(br.readLine().trim());
            String[] passwords = br.readLine().trim().split("\\s+");
            String loginAttempt = br.readLine().trim();
            int L = loginAttempt.length();

            boolean[] dp = new boolean[L + 1];
            int[] parent = new int[L + 1];
            String[] usedWord = new String[L + 1];
            dp[0] = true;

            for (int i = 0; i < L; i++) {
                if (!dp[i]) continue;
                for (String w : passwords) {
                    int len = w.length();
                    if (i + len <= L && loginAttempt.startsWith(w, i)) {
                        if (!dp[i + len]) {
                            dp[i + len] = true;
                            parent[i + len] = i;
                            usedWord[i + len] = w;
                        }
                    }
                }
            }

            if (!dp[L]) {
                sb.append("WRONG PASSWORD\n");
            } else {
                List<String> path = new ArrayList<>();
                int pos = L;
                while (pos > 0) {
                    path.add(usedWord[pos]);
                    pos = parent[pos];
                }
                Collections.reverse(path);
                sb.append(String.join(" ", path)).append("\n");
            }
        }

        System.out.print(sb);
    }
}
