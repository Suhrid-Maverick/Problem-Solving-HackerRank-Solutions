import java.io.*;

public class Solution {
    public static void main(String[] args) throws IOException {
        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
        int q = Integer.parseInt(br.readLine().trim());
        StringBuilder sb = new StringBuilder();

        while (q-- > 0) {
            String s = br.readLine().trim();
            int n = s.length();

            if (n == 1 || s.charAt(0) == '0') {
                sb.append("NO\n");
                continue;
            }

            boolean found = false;

            for (int len = 1; len <= n / 2; len++) {
                long first = Long.parseLong(s.substring(0, len));
                long current = first;
                int idx = len;
                boolean valid = true;

                while (idx < n) {
                    current++;
                    String next = Long.toString(current);
                    if (!s.startsWith(next, idx)) {
                        valid = false;
                        break;
                    }
                    idx += next.length();
                }

                if (valid) {
                    sb.append("YES ").append(first).append('\n');
                    found = true;
                    break;
                }
            }

            if (!found) {
                sb.append("NO\n");
            }
        }

        System.out.print(sb);
    }
}
