import java.io.*;
import java.util.*;

public class Main {
    static final int MOD = 1000000007;

    static class BIT {
        int[] bit;
        int n;

        BIT(int n) {
            this.n = n;
            bit = new int[n + 2];
        }

        void add(int idx, int val) {
            while (idx <= n) {
                bit[idx] += val;
                idx += idx & -idx;
            }
        }

        int sum(int idx) {
            int res = 0;
            while (idx > 0) {
                res += bit[idx];
                idx -= idx & -idx;
            }
            return res;
        }
    }

    static class FastScanner {
        BufferedReader br;
        StringTokenizer st;

        FastScanner() {
            br = new BufferedReader(new InputStreamReader(System.in));
            st = new StringTokenizer("");
        }

        String next() throws IOException {
            while (!st.hasMoreTokens()) {
                st = new StringTokenizer(br.readLine());
            }
            return st.nextToken();
        }

        int nextInt() throws IOException {
            return Integer.parseInt(next());
        }
    }

    public static void main(String[] args) throws IOException {
        FastScanner fs = new FastScanner();

        int n = fs.nextInt();
        int[] a = new int[n + 1];
        boolean[] present = new boolean[n + 1];

        long sumPresent = 0;
        int positive = 0;

        for (int i = 1; i <= n; i++) {
            a[i] = fs.nextInt();
            if (a[i] != 0) {
                present[a[i]] = true;
                sumPresent += a[i];
                positive++;
            }
        }

        int k = n - positive;

        int[] fact = new int[n + 1];
        fact[0] = 1;
        for (int i = 1; i <= n; i++) {
            fact[i] = (int) ((long) fact[i - 1] * i % MOD);
        }

        if (k == 0) {
            BIT bit = new BIT(n);
            long ans = 1;

            for (int i = 1; i <= n; i++) {
                int v = a[i];
                int seenLess = bit.sum(v - 1);
                int unusedLess = v - 1 - seenLess;
                ans = (ans + (long) unusedLess * fact[n - i]) % MOD;
                bit.add(v, 1);
            }

            System.out.println(ans);
            return;
        }

        int[] prefMissing = new int[n + 1];
        int cnt = 0;
        for (int v = 1; v <= n; v++) {
            if (!present[v]) cnt++;
            prefMissing[v] = cnt;
        }

        long sumAll = (long) n * (n + 1) / 2;
        int sumMissing = (int) ((sumAll - sumPresent) % MOD);
        if (sumMissing < 0) sumMissing += MOD;

        BIT bit = new BIT(n);
        long ans = fact[k];
        long prefixP = 0;
        int zerosBefore = 0;
        int inv2 = (MOD + 1) / 2;

        for (int i = 1; i <= n; i++) {
            if (a[i] == 0) {
                long bracket = (sumMissing - k - prefixP) % MOD;
                if (bracket < 0) bracket += MOD;

                long val = (long) fact[k - 1] * bracket % MOD;
                long sub = (long) zerosBefore * fact[k] % MOD * inv2 % MOD;
                val = (val - sub) % MOD;
                if (val < 0) val += MOD;

                ans = (ans + val * fact[n - i]) % MOD;
                zerosBefore++;
            } else {
                int v = a[i];
                int fixedLess = bit.sum(v - 1);
                int c = v - 1 - fixedLess;
                int missingLess = prefMissing[v - 1];

                long term = ((long) k * c - (long) zerosBefore * missingLess) % MOD;
                term = term * fact[k - 1] % MOD;

                ans = (ans + term * fact[n - i]) % MOD;

                bit.add(v, 1);

                int missingGreater = k - missingLess;
                prefixP += missingGreater;
                if (prefixP >= MOD) prefixP -= MOD;
            }
        }

        ans %= MOD;
        if (ans < 0) ans += MOD;
        System.out.println(ans);
    }
}
