import java.io.*;
import java.util.*;

public class Solution {
    static class FastScanner {
        private final int BUFFER_SIZE = 1 << 16;
        private DataInputStream din;
        private byte[] buffer;
        private int bufferPointer, bytesRead;
        FastScanner() {
            din = new DataInputStream(System.in);
            buffer = new byte[BUFFER_SIZE];
            bufferPointer = bytesRead = 0;
        }
        int nextInt() throws IOException {
            int ret = 0;
            byte c = read();
            while (c <= ' ') c = read();
            boolean neg = (c == '-');
            if (neg) c = read();
            do { ret = ret * 10 + c - '0'; } while ((c = read()) >= '0' && c <= '9');
            return neg ? -ret : ret;
        }
        String nextLine() throws IOException {
            StringBuilder sb = new StringBuilder();
            byte c = read();
            while (c <= ' ') c = read();
            do { sb.append((char) c); } while ((c = read()) > ' ');
            return sb.toString();
        }
        private byte read() throws IOException {
            if (bufferPointer == bytesRead) fillBuffer();
            return buffer[bufferPointer++];
        }
        private void fillBuffer() throws IOException {
            bytesRead = din.read(buffer, 0, BUFFER_SIZE);
            if (bytesRead == -1) buffer[0] = -1;
            bufferPointer = 0;
        }
    }

    static int[] len, link;
    static int[][] next;
    static int nodes, last;

    static void saExtend(int c) {
        int cur = ++nodes;
        len[cur] = len[last] + 1;
        int p = last;
        while (p != 0 && next[p][c] == 0) {
            next[p][c] = cur;
            p = link[p];
        }
        if (p == 0) {
            link[cur] = 1;
        } else {
            int q = next[p][c];
            if (len[p] + 1 == len[q]) {
                link[cur] = q;
            } else {
                int clone = ++nodes;
                len[clone] = len[p] + 1;
                System.arraycopy(next[q], 0, next[clone], 0, 26);
                link[clone] = link[q];
                while (p != 0 && next[p][c] == q) {
                    next[p][c] = clone;
                    p = link[p];
                }
                link[q] = link[cur] = clone;
            }
        }
        last = cur;
    }

    static void addGap(TreeMap<Integer, Integer> gm, int g) {
        Integer c = gm.get(g);
        if (c == null) gm.put(g, 1);
        else gm.put(g, c + 1);
    }

    static void removeGap(TreeMap<Integer, Integer> gm, int g) {
        Integer c = gm.get(g);
        if (c == 1) gm.remove(g);
        else gm.put(g, c - 1);
    }

    public static void main(String[] args) throws IOException {
        FastScanner fs = new FastScanner();
        String s = fs.nextLine();
        int k = fs.nextInt();
        int n = s.length();

        int maxNodes = 2 * n + 2;
        len = new int[maxNodes];
        link = new int[maxNodes];
        next = new int[maxNodes][26];
        nodes = last = 1;
        len[1] = 0;
        link[1] = 0;

        int[] prefixState = new int[n];
        for (int i = 0; i < n; i++) {
            saExtend(s.charAt(i) - 'a');
            prefixState[i] = last;
        }

        int maxLen = 0;
        for (int i = 1; i <= nodes; i++) if (len[i] > maxLen) maxLen = len[i];
        int[] cnt = new int[maxLen + 1];
        for (int i = 1; i <= nodes; i++) cnt[len[i]]++;
        for (int i = 1; i <= maxLen; i++) cnt[i] += cnt[i - 1];
        int[] order = new int[nodes + 1];
        for (int i = nodes; i >= 1; i--) order[cnt[len[i]]--] = i;

        @SuppressWarnings("unchecked")
        TreeSet<Integer>[] posset = new TreeSet[nodes + 1];
        @SuppressWarnings("unchecked")
        TreeMap<Integer, Integer>[] gapmap = new TreeMap[nodes + 1];
        for (int i = 1; i <= nodes; i++) {
            posset[i] = new TreeSet<>();
            gapmap[i] = new TreeMap<>();
        }
        for (int i = 0; i < n; i++) posset[prefixState[i]].add(i);

        long ans = 0;

        for (int idx = nodes; idx >= 1; idx--) {
            int v = order[idx];
            int minL = len[link[v]] + 1;
            int maxL = len[v];

            if (minL <= maxL && posset[v] != null) {
                int m = posset[v].size();
                if (m == 1) {
                    if (k == 1) ans += (long)(maxL - minL + 1);
                } else if (m >= 2) {
                    TreeMap<Integer, Integer> gm = gapmap[v];
                    int t = m - 1;

                    if (k == 1) {
                        int maxGap = gm.lastKey();
                        long Lmin = Math.max(minL, maxGap);
                        long Lmax = maxL;
                        if (Lmin <= Lmax) ans += (Lmax - Lmin + 1);
                    } else if (k - 1 <= t) {
                        long Lmin, Lmax;
                        if (k - 1 == t) {
                            int minGap = gm.firstKey();
                            Lmin = minL;
                            Lmax = Math.min(maxL, (long)minGap - 1);
                        } else {
                            int hk = -1, hkm1 = -1;
                            int cum = 0;
                            int targetKm1 = k - 1;
                            for (Map.Entry<Integer, Integer> e : gm.descendingMap().entrySet()) {
                                cum += e.getValue();
                                if (hkm1 == -1 && cum >= targetKm1) hkm1 = e.getKey();
                                if (cum >= k) { hk = e.getKey(); break; }
                            }
                            Lmin = Math.max(minL, hk);
                            Lmax = Math.min(maxL, (long)hkm1 - 1);
                        }
                        if (Lmin <= Lmax) ans += (Lmax - Lmin + 1);
                    }
                }
            }

            int p = link[v];
            if (p != 0 && posset[v] != null) {
                if (posset[v].size() > posset[p].size()) {
                    TreeSet<Integer> tmp = posset[p];
                    posset[p] = posset[v];
                    posset[v] = tmp;
                    TreeMap<Integer, Integer> tmp2 = gapmap[p];
                    gapmap[p] = gapmap[v];
                    gapmap[v] = tmp2;
                }
                TreeSet<Integer> bigSet = posset[p];
                TreeMap<Integer, Integer> bigGaps = gapmap[p];
                for (int x : posset[v]) {
                    Integer pred = bigSet.lower(x);
                    Integer succ = bigSet.higher(x);
                    if (pred != null && succ != null) {
                        removeGap(bigGaps, succ - pred);
                        addGap(bigGaps, x - pred);
                        addGap(bigGaps, succ - x);
                    } else if (pred != null) {
                        addGap(bigGaps, x - pred);
                    } else if (succ != null) {
                        addGap(bigGaps, succ - x);
                    }
                    bigSet.add(x);
                }
                posset[v] = null;
                gapmap[v] = null;
            }
        }

        System.out.println(ans);
    }
}
