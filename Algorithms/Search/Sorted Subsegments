import java.io.*;
import java.util.*;

public class Solution {
    static int n, q, k;
    static int[] a, L, R, unique;
    static int[] tree, lazy;

    public static void main(String[] args) throws IOException {
        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
        StringTokenizer st = new StringTokenizer(br.readLine());
        n = Integer.parseInt(st.nextToken());
        q = Integer.parseInt(st.nextToken());
        k = Integer.parseInt(st.nextToken());

        a = new int[n];
        st = new StringTokenizer(br.readLine());
        for (int i = 0; i < n; i++) a[i] = Integer.parseInt(st.nextToken());

        L = new int[q];
        R = new int[q];
        for (int i = 0; i < q; i++) {
            st = new StringTokenizer(br.readLine());
            L[i] = Integer.parseInt(st.nextToken());
            R[i] = Integer.parseInt(st.nextToken());
        }

        // Unique sorted values for binary search
        int[] sorted = a.clone();
        Arrays.sort(sorted);
        unique = new int[n];
        int m = 0;
        for (int i = 0; i < n; i++) {
            if (i == 0 || sorted[i] != sorted[i - 1]) {
                unique[m++] = sorted[i];
            }
        }
        unique = Arrays.copyOf(unique, m);

        int lo = 0, hi = m - 1, ans = unique[0];
        while (lo <= hi) {
            int mid = (lo + hi) >>> 1;
            if (check(mid)) {
                ans = unique[mid];
                lo = mid + 1;
            } else {
                hi = mid - 1;
            }
        }

        System.out.println(ans);
    }

    static boolean check(int mid) {
        int[] b = new int[n];
        for (int i = 0; i < n; i++) {
            b[i] = a[i] >= unique[mid] ? 1 : 0;
        }

        tree = new int[4 * n + 5];
        lazy = new int[4 * n + 5];
        Arrays.fill(lazy, -1);
        build(1, 0, n - 1, b);

        for (int i = 0; i < q; i++) {
            int l = L[i], r = R[i];
            int ones = query(1, 0, n - 1, l, r);
            update(1, 0, n - 1, l, r, 0);
            if (ones > 0) {
                update(1, 0, n - 1, r - ones + 1, r, 1);
            }
        }
        return query(1, 0, n - 1, k, k) == 1;
    }

    static void build(int node, int start, int end, int[] b) {
        lazy[node] = -1;
        if (start == end) {
            tree[node] = b[start];
        } else {
            int mid = (start + end) >>> 1;
            build(node << 1, start, mid, b);
            build(node << 1 | 1, mid + 1, end, b);
            tree[node] = tree[node << 1] + tree[node << 1 | 1];
        }
    }

    static void push(int node, int start, int end) {
        if (lazy[node] != -1) {
            int val = lazy[node];
            tree[node] = val * (end - start + 1);
            if (start != end) {
                lazy[node << 1] = val;
                lazy[node << 1 | 1] = val;
            }
            lazy[node] = -1;
        }
    }

    static void update(int node, int start, int end, int l, int r, int val) {
        push(node, start, end);
        if (start > r || end < l) return;
        if (l <= start && end <= r) {
            lazy[node] = val;
            push(node, start, end);
            return;
        }
        int mid = (start + end) >>> 1;
        update(node << 1, start, mid, l, r, val);
        update(node << 1 | 1, mid + 1, end, l, r, val);
        tree[node] = tree[node << 1] + tree[node << 1 | 1];
    }

    static int query(int node, int start, int end, int l, int r) {
        push(node, start, end);
        if (start > r || end < l) return 0;
        if (l <= start && end <= r) return tree[node];
        int mid = (start + end) >>> 1;
        return query(node << 1, start, mid, l, r) + query(node << 1 | 1, mid + 1, end, l, r);
    }
}
