import java.io.*;

public class Solution {
    static final int MOD = 1000000007;

    public static void main(String[] args) throws IOException {
        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
        String s = br.readLine().trim();

        int[] dp1 = new int[26];
        int[][] dp2 = new int[26][26];
        int[][] dp3 = new int[26][26];

        long ans = 0;

        for (int i = 0; i < s.length(); i++) {
            int c = s.charAt(i) - 'a';

            // current character as the final x in x y y x
            for (int b = 0; b < 26; b++) {
                ans += dp3[c][b];
            }
            ans %= MOD;

            // current character as the second y in x y y
            for (int a = 0; a < 26; a++) {
                dp3[a][c] += dp2[a][c];
                if (dp3[a][c] >= MOD) dp3[a][c] -= MOD;
            }

            // current character as the first y in x y
            for (int a = 0; a < 26; a++) {
                dp2[a][c] += dp1[a];
                if (dp2[a][c] >= MOD) dp2[a][c] -= MOD;
            }

            // current character as the first x
            dp1[c]++;
        }

        System.out.println(ans % MOD);
    }
}
