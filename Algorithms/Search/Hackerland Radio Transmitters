import java.io.*;
import java.util.*;

public class Solution {
    public static void main(String[] args) throws IOException {
        StreamTokenizer in = new StreamTokenizer(new BufferedReader(new InputStreamReader(System.in)));

        in.nextToken();
        int n = (int) in.nval;

        in.nextToken();
        int k = (int) in.nval;

        int[] x = new int[n];
        for (int i = 0; i < n; i++) {
            in.nextToken();
            x[i] = (int) in.nval;
        }

        Arrays.sort(x);

        int ans = 0;
        for (int i = 0; i < n; ans++) {
            int j = i;
            while (j < n && x[j] <= x[i] + k) j++;

            int reach = x[j - 1] + k;
            while (i < n && x[i] <= reach) i++;
        }

        System.out.println(ans);
    }
}
