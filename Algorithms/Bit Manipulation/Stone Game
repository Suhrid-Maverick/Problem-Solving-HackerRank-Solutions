    private static long solve(int n, int[] nums) {
        int xor = 0;
        for (int i = 0; i < n; i++) {
            xor ^= nums[i];
        }
        return nimMoves(nums, 0, xor, 0, n - 1);
    }

    private static int nimMoves(int[] nums, int cur, int xor, int changes, int maxChanges) {
        if (cur == nums.length || changes == maxChanges) {
            return (xor == 0) ? 1 : 0;
        } else {
            int moves = 0;
            for (int i = 0; i < nums[cur]; i++) {
                moves += nimMoves(nums, cur + 1, xor ^ nums[cur] ^ i, changes + 1, maxChanges);
            }
            moves += nimMoves(nums, cur + 1, xor, changes, maxChanges);
            return moves;
        }
    }

