import java.util.*;

public class Solution {
    public static long flippingBits(long n) {
        return n ^ 0xFFFFFFFFL;
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int q = sc.nextInt();
        while (q-- > 0) {
            long n = sc.nextLong();
            System.out.println(flippingBits(n));
        }
        sc.close();
    }
}
