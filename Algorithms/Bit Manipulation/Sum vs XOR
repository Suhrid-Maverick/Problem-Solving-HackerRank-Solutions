import java.util.*;

public class Solution {
    public static long sumXor(long n) {
        long result = 1;
        while (n > 0) {
            if ((n & 1) == 0) result <<= 1;
            n >>= 1;
        }
        return result;
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        long n = sc.nextLong();
        System.out.println(sumXor(n));
        sc.close();
    }
}
