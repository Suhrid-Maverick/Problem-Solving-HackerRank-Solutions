import java.io.*;
import java.util.*;

public class Solution {
    public static void main(String[] args) throws IOException {
        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
        int n = Integer.parseInt(br.readLine().trim());
        if (n < 2) {
            System.out.println(0);
            return;
        }
        StringTokenizer st = new StringTokenizer(br.readLine());
        int[] a = new int[n + 1]; // 1-based indexing
        for (int i = 1; i <= n; i++) {
            a[i] = Integer.parseInt(st.nextToken());
        }

        // c[i] = a[i] - a[i-1], with c[1] = a[1]
        int[] c = new int[n + 1];
        c[1] = a[1];
        for (int i = 2; i <= n; i++) {
            c[i] = a[i] - a[i - 1];
        }

        // Prefix XORs for odd and even indices of c
        int[] P_odd = new int[n + 1];
        int[] P_even = new int[n + 1];
        for (int i = 1; i <= n; i++) {
            P_odd[i] = P_odd[i - 1];
            P_even[i] = P_even[i - 1];
            if (i % 2 == 1) {
                P_odd[i] ^= c[i];
            } else {
                P_even[i] ^= c[i];
            }
        }

        // Count losing subarrays of even length
        long countEvenLose = 0;
        Map<Integer, Integer> mapEven = new HashMap<>(); // L even: P_odd[L]
        Map<Integer, Integer> mapOdd = new HashMap<>();  // L odd: P_even[L]
        for (int R = 1; R <= n; R++) {
            if (R % 2 == 0) {
                countEvenLose += mapOdd.getOrDefault(P_even[R], 0);
                mapEven.put(P_odd[R], mapEven.getOrDefault(P_odd[R], 0) + 1);
            } else {
                countEvenLose += mapEven.getOrDefault(P_odd[R], 0);
                mapOdd.put(P_even[R], mapOdd.getOrDefault(P_even[R], 0) + 1);
            }
        }

        // Count losing subarrays of odd length
        long countOddLose = 0;
        Map<Integer, Integer> map0 = new HashMap<>(); // L even: K(L)
        Map<Integer, Integer> map1 = new HashMap<>(); // L odd: K(L)
        for (int R = 1; R <= n; R++) {
            if (R >= 3) {
                int L = R - 2;
                int p = L % 2;
                int K = a[L] ^ (p == 1 ? P_odd[L + 1] : P_even[L + 1]);
                if (p == 0) {
                    map0.put(K, map0.getOrDefault(K, 0) + 1);
                } else {
                    map1.put(K, map1.getOrDefault(K, 0) + 1);
                }
            }
            int p = R % 2;
            if (p == 0) {
                countOddLose += map0.getOrDefault(P_even[R], 0);
            } else {
                countOddLose += map1.getOrDefault(P_odd[R], 0);
            }
        }

        long total = (long) n * (n - 1) / 2;
        long losing = countEvenLose + countOddLose;
        long answer = total - losing;
        System.out.println(answer);
    }
}
