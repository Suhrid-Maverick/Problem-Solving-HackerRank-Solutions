import java.util.*;

public class Solution {

    public static String misereNim(int[] s) {
        int xorSum = 0;
        boolean allOnes = true;

        for (int stones : s) {
            xorSum ^= stones;
            if (stones != 1) {
                allOnes = false;
            }
        }

        if (allOnes) {
            return (s.length % 2 == 0) ? "First" : "Second";
        }

        return (xorSum != 0) ? "First" : "Second";
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int t = sc.nextInt();

        while (t-- > 0) {
            int n = sc.nextInt();
            int[] s = new int[n];

            for (int i = 0; i < n; i++) {
                s[i] = sc.nextInt();
            }

            System.out.println(misereNim(s));
        }

        sc.close();
    }
}
