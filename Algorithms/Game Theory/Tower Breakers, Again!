import java.io.*;
import java.util.*;

public class Solution {
    static int[] primes;
    static int primeCount;

    static void sieve(int max) {
        boolean[] isPrime = new boolean[max + 1];
        Arrays.fill(isPrime, true);
        isPrime[0] = isPrime[1] = false;
        for (int i = 2; i * i <= max; i++) {
            if (isPrime[i]) {
                for (int j = i * i; j <= max; j += i) {
                    isPrime[j] = false;
                }
            }
        }
        primeCount = 0;
        for (int i = 2; i <= max; i++) {
            if (isPrime[i]) primeCount++;
        }
        primes = new int[primeCount];
        int idx = 0;
        for (int i = 2; i <= max; i++) {
            if (isPrime[i]) primes[idx++] = i;
        }
    }

    static int grundy(int n) {
        if (n == 1) return 0;
        int original = n;
        int oddFactors = 0;
        // remove all factors of 2
        while (n % 2 == 0) {
            n /= 2;
        }
        // factor the odd part
        for (int i = 0; i < primeCount && primes[i] * primes[i] <= n; i++) {
            int p = primes[i];
            if (p == 2) continue;
            while (n % p == 0) {
                oddFactors++;
                n /= p;
            }
        }
        if (n > 1) {
            oddFactors++;
        }
        return oddFactors + (original % 2 == 0 ? 1 : 0);
    }

    public static void main(String[] args) throws IOException {
        // sqrt(10^9) ~ 31623, 40000 is safe
        sieve(40000);
        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
        int T = Integer.parseInt(br.readLine().trim());
        StringBuilder sb = new StringBuilder();
        while (T-- > 0) {
            int N = Integer.parseInt(br.readLine().trim());
            StringTokenizer st = new StringTokenizer(br.readLine());
            int xor = 0;
            for (int i = 0; i < N; i++) {
                int h = Integer.parseInt(st.nextToken());
                xor ^= grundy(h);
            }
            sb.append(xor != 0 ? "1\n" : "2\n");
        }
        System.out.print(sb);
    }
}
