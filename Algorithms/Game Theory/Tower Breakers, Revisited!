import java.io.*;
import java.util.*;

public class Solution {
    public static void main(String[] args) throws IOException {
        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
        String line = br.readLine();
        if (line == null) return;
        int T = Integer.parseInt(line.trim());
        
        List<int[]> cases = new ArrayList<>();
        int maxH = 0;
        
        for (int t = 0; t < T; t++) {
            // read n
            line = br.readLine();
            while (line != null && line.trim().isEmpty()) line = br.readLine();
            int n = Integer.parseInt(line.trim());
            
            // read heights
            line = br.readLine();
            while (line != null && line.trim().isEmpty()) line = br.readLine();
            StringTokenizer st = new StringTokenizer(line);
            int[] arr = new int[n];
            for (int i = 0; i < n; i++) {
                arr[i] = Integer.parseInt(st.nextToken());
                if (arr[i] > maxH) maxH = arr[i];
            }
            cases.add(arr);
        }
        
        // omega[i] = number of prime factors of i, counted with multiplicity
        int[] omega = new int[maxH + 1];
        if (maxH >= 2) {
            int[] spf = new int[maxH + 1];
            int[] primes = new int[maxH + 1];
            int cnt = 0;
            for (int i = 2; i <= maxH; i++) {
                if (spf[i] == 0) {
                    spf[i] = i;
                    primes[cnt++] = i;
                }
                for (int j = 0; j < cnt && i * primes[j] <= maxH; j++) {
                    spf[i * primes[j]] = primes[j];
                    if (i % primes[j] == 0) break;
                }
            }
            omega[1] = 0;
            for (int i = 2; i <= maxH; i++) {
                omega[i] = omega[i / spf[i]] + 1;
            }
        }
        
        StringBuilder sb = new StringBuilder();
        for (int[] arr : cases) {
            int xor = 0;
            for (int h : arr) {
                xor ^= omega[h];
            }
            sb.append(xor != 0 ? "1\n" : "2\n");
        }
        System.out.print(sb);
    }
}
