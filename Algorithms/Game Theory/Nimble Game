import java.util.*;

public class Solution {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int t = sc.nextInt();

        while (t-- > 0) {
            int n = sc.nextInt();
            int xor = 0;

            for (int i = 0; i < n; i++) {
                int coins = sc.nextInt();
                if ((coins & 1) == 1) {
                    xor ^= i;
                }
            }

            System.out.println(xor != 0 ? "First" : "Second");
        }

        sc.close();
    }
}
