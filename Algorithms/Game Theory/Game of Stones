import java.util.*;

public class Solution {
    public static String gameOfStones(int n) {
        return (n % 7 == 0 || n % 7 == 1) ? "Second" : "First";
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int t = sc.nextInt();
        while (t-- > 0) {
            int n = sc.nextInt();
            System.out.println(gameOfStones(n));
        }
        sc.close();
    }
}
