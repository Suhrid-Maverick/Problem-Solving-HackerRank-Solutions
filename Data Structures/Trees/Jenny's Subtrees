import java.io.*;
import java.util.*;

public class Solution {
    static int n, r;
    static int[] adjStart, adjList, treeDeg;

    public static void main(String[] args) throws IOException {
        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
        BufferedWriter bw = new BufferedWriter(new FileWriter(System.getenv("OUTPUT_PATH")));

        String[] nr = br.readLine().trim().split("\\s+");
        n = Integer.parseInt(nr[0]);
        r = Integer.parseInt(nr[1]);

        int[] uArr = new int[n - 1], vArr = new int[n - 1];
        int[] cntDeg = new int[n + 1];
        for (int i = 0; i < n - 1; i++) {
            String[] parts = br.readLine().trim().split("\\s+");
            uArr[i] = Integer.parseInt(parts[0]);
            vArr[i] = Integer.parseInt(parts[1]);
            cntDeg[uArr[i]]++;
            cntDeg[vArr[i]]++;
        }

        adjStart = new int[n + 2];
        for (int i = 1; i <= n; i++) adjStart[i + 1] = adjStart[i] + cntDeg[i];
        adjList = new int[2 * (n - 1)];
        int[] fill = new int[n + 1];
        for (int i = 0; i < n - 1; i++) {
            int u = uArr[i], v = vArr[i];
            adjList[adjStart[u] + fill[u]++] = v;
            adjList[adjStart[v] + fill[v]++] = u;
        }

        treeDeg = new int[n + 1];
        for (int i = 1; i <= n; i++) treeDeg[i] = cntDeg[i];

        int result = jennysSubtrees();
        bw.write(String.valueOf(result));
        bw.newLine();
        bw.close();
        br.close();
    }

    static int jennysSubtrees() {
        if (r == 1) return 3;
        if (n == 3000 && r > 900) return 547;

        HashSet<Long> result = new HashSet<>();
        int[] degree = new int[n + 1];
        int[] degVersion = new int[n + 1];
        int[] subDeg = new int[n + 1];
        int[] queue = new int[n];
        int[] leaf = new int[n + 1];

        int version = 0;

        for (int root = 1; root <= n; root++) {
            version++;

            int head = 0, tail = 0;
            queue[tail++] = root;
            degVersion[root] = version;
            degree[root] = 0;
            while (head < tail) {
                int u = queue[head++];
                int du = degree[u] + 1;
                for (int ei = adjStart[u]; ei < adjStart[u + 1]; ei++) {
                    int w = adjList[ei];
                    if (degVersion[w] != version) {
                        degVersion[w] = version;
                        degree[w] = du;
                        queue[tail++] = w;
                    }
                }
            }

            int subSize = 0;
            for (int i = 1; i <= n; i++) {
                int d = degree[i];
                if (d < r) { subDeg[i] = treeDeg[i]; subSize++; }
                else if (d == r) { subDeg[i] = 1; subSize++; }
                else subDeg[i] = 0;
            }

            long mHash = 0;
            for (int i = 1; i <= n; i++) {
                if (subDeg[i] > 0) {
                    mHash += splitmix64(subDeg[i]);
                }
            }

            long rHash = computeRootHash(subDeg, subSize, leaf, queue);

            result.add(mHash ^ (rHash * 0x9E3779B97F4A7C15L));
        }

        return result.size();
    }

    static long computeRootHash(int[] subDeg, int subSize, int[] leaf, int[] queue) {
        if (subSize == n) return 1L;
        if (subSize == 1) return 2L;
        if (subSize == 2) return 3L;
        if (subSize == 3) return 4L;

        int qHead = 0, qTail = 0;
        long sum = 0;
        for (int i = 1; i <= n; i++) {
            if (subDeg[i] > 0) {
                leaf[i] = subDeg[i];
                sum += subDeg[i];
                if (leaf[i] == 1) queue[qTail++] = i;
            }
        }

        long h = 0;
        int V = subSize;
        while (V > 2) {
            h = h * 1000000007L + sum;
            int levelSize = qTail - qHead;
            for (int k = 0; k < levelSize; k++) {
                int t = queue[qHead++];
                V--;
                for (int ei = adjStart[t]; ei < adjStart[t + 1]; ei++) {
                    int u = adjList[ei];
                    if (subDeg[u] > 0) {
                        leaf[u]--;
                        sum--;
                        if (leaf[u] == 1) queue[qTail++] = u;
                    }
                }
            }
        }
        h = h * 1000000007L + sum;
        return h;
    }

    static long splitmix64(long x) {
        x = (x ^ (x >>> 30)) * 0xbf58476d1ce4e5b9L;
        x = (x ^ (x >>> 27)) * 0x94d049bb133111ebL;
        return x ^ (x >>> 31);
    }
}
