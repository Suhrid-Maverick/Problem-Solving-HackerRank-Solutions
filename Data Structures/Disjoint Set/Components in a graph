import java.io.*;
import java.util.*;

public class Solution {

    static boolean DEBUG = System.getenv("HR_DEBUG") != null;

    static void debug(Object payload) {
        if (DEBUG) {
            System.out.println(payload);
        }
    }

    static class Node {
        Node parent;
        int value;
        int size;

        Node(Node parent, int value, int size) {
            this.parent = parent;
            this.value = value;
            this.size = size;
        }

        @Override
        public String toString() {
            return (value + 1) + " -> " + (parent == null ? "null" : String.valueOf(parent.value + 1));
        }
    }

    static class DSU {
        int n;
        List<Node> tree;

        DSU(int n) {
            this.n = n;
            this.tree = new ArrayList<>(n);
            for (int i = 0; i < n; i++) {
                tree.add(new Node(null, i, 1));
            }
        }

        Node find(int value) {
            Node n = tree.get(value);
            while (n.parent != null) {
                n = n.parent;
            }

            Node n2 = tree.get(value);
            while (n2.parent != null) {
                Node savedParent = n2.parent;
                n2.parent = n;
                n2 = savedParent;
            }

            return n;
        }

        void union(int i, int j) {
            Node iNode = find(i);
            Node jNode = find(j);
            if (jNode == iNode) {
                return;
            }
            if (iNode.size > jNode.size) {
                jNode.parent = iNode;
                iNode.size += jNode.size;
            } else {
                iNode.parent = jNode;
                jNode.size += iNode.size;
            }
        }

        @Override
        public String toString() {
            return tree.toString();
        }
    }

    static List<Integer> counts(DSU dsu) {
        int largest = 0;
        Integer smallest = null;

        for (Node i : dsu.tree) {
            Node root = dsu.find(i.value);
            if (root.size > largest) {
                largest = root.size;
            }
            if (root.size > 1 && (smallest == null || root.size < smallest)) {
                smallest = root.size;
            }
            debug(root.size);
        }

        List<Integer> result = new ArrayList<>();
        result.add(smallest);
        result.add(largest);
        return result;
    }

    static List<Integer> componentsInGraph(List<List<Integer>> gb) {
        int n = gb.size();

        debug(String.valueOf(n));

        DSU dsu = new DSU(n * 2);

        debug(dsu);

        for (List<Integer> edge : gb) {
            dsu.union(edge.get(0) - 1, edge.get(1) - 1);
        }

        return counts(dsu);
    }

    public static void main(String[] args) throws IOException {
        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
        BufferedWriter bw = new BufferedWriter(new FileWriter(System.getenv("OUTPUT_PATH")));

        int n = Integer.parseInt(br.readLine().trim());

        List<List<Integer>> gb = new ArrayList<>();

        for (int i = 0; i < n; i++) {
            String[] parts = br.readLine().trim().split(" ");
            List<Integer> edge = new ArrayList<>();
            edge.add(Integer.parseInt(parts[0]));
            edge.add(Integer.parseInt(parts[1]));
            gb.add(edge);
        }

        List<Integer> result = componentsInGraph(gb);

        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < result.size(); i++) {
            if (i > 0) sb.append(" ");
            sb.append(result.get(i));
        }
        bw.write(sb.toString());
        bw.newLine();

        bw.close();
        br.close();
    }
}
