import java.io.*;
import java.util.*;

public class Solution {
    static long Sum(long[] bit, int n) {
        long ret = bit[0];
        while (n > 0) {
            ret += bit[n];
            n -= n & -n;
        }
        return ret;
    }

    static void Update(long[] bit, int n, long v, int limit) {
        while (n <= limit) {
            bit[n] += v;
            n += n & -n;
        }
    }

    public static void main(String[] args) throws IOException {
        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
        int n = Integer.parseInt(br.readLine().trim());
        String[] parts = br.readLine().trim().split("\\s+");
        int[][] num = new int[n][2];
        for (int i = 0; i < n; i++) {
            num[i][0] = Integer.parseInt(parts[i]);
            num[i][1] = i + 1;
        }
        Arrays.sort(num, new Comparator<int[]>() {
            public int compare(int[] a, int[] b) {
                if (a[0] != b[0]) return Integer.compare(a[0], b[0]);
                return Integer.compare(a[1], b[1]);
            }
        });
        int m = n + 1;
        long[][] s = new long[4][m + 1];
        s[0][0] = 1;

        for (int i = 0; i < n; i++) {
            if (i > 0 && num[i - 1][0] == num[i][0]) continue;
            List<int[]> process = new ArrayList<>();
            process.add(num[i]);
            if (i + 1 < n && num[i][0] == num[i + 1][0]) {
                process.add(num[i + 1]);
            }
            for (int state = 3; state >= 1; state--) {
                List<Long> values = new ArrayList<>();
                for (int[] p : process) {
                    int id = p[1];
                    values.add(Sum(s[state - 1], id - 1));
                }
                if (values.size() > 1) {
                    values.set(1, values.get(1) - values.get(0));
                }
                for (int j = 0; j < process.size(); j++) {
                    int id = process.get(j)[1];
                    Update(s[state], id, values.get(j), m);
                }
            }
        }
        System.out.println(Sum(s[3], m - 1));
    }
}
