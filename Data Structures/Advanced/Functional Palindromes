import java.io.*;
import java.util.*;

public class Main {
    static final int MAXN = 105005;
    static final int MOD1 = 1000000007;
    static final int PRIME = 100001;

    static int n, q, len;
    static char[] s;

    // Palindromic tree (Eertree)
    static int[][] pNext = new int[MAXN][26];
    static int[] pLen = new int[MAXN];
    static int[] pSufflink = new int[MAXN];
    static int[] pNum = new int[MAXN];
    static int[] pL = new int[MAXN];
    static int[] pR = new int[MAXN];
    static int pNumNodes, suff;

    // Suffix array + LCP
    static int[] iSA = new int[MAXN];
    static int[] SA = new int[MAXN];
    static int[] lcp = new int[MAXN];
    static int[][] LCP = new int[MAXN][22];

    // Rolling hash
    static int[] P = new int[MAXN];
    static int[] HashF = new int[MAXN];
    static int[] HashR = new int[MAXN];

    public static void main(String[] args) throws IOException {
        FastReader in = new FastReader(System.in);
        n = in.nextInt();
        q = in.nextInt();
        s = in.next().toCharArray();
        len = n;

        // Precompute powers for rolling hash
        P[0] = 1;
        for (int i = 1; i < MAXN; i++) {
            P[i] = (int) (1L * P[i - 1] * PRIME % MOD1);
        }

        initTree();
        suffixSort();
        initLCP();
        constructLCP();

        for (int i = 0; i < len; i++) addLetter(i);

        // Accumulate occurrence counts from children up to parents.
        // Since sufflink[i] < i for all i > 2, process in decreasing order.
        for (int i = pNumNodes; i >= 3; i--) {
            pNum[pSufflink[i]] += pNum[i];
        }

        // Build list of palindromes (nodes 3..pNumNodes)
        int numPal = pNumNodes - 2;
        int[][] A = new int[Math.max(1, numPal)][];
        int AIdx = 0;
        for (int i = 3; i <= pNumNodes; i++) {
            A[AIdx++] = new int[]{pL[i], pR[i], pNum[i]};
        }

        // Sort palindromes lexicographically using SA + LCP
        Arrays.sort(A, 0, AIdx, new Comparator<int[]>() {
            public int compare(int[] a, int[] b) {
                int l1 = a[0], r1 = a[1];
                int l2 = b[0], r2 = b[1];
                int len1 = r1 - l1 + 1;
                int len2 = r2 - l2 + 1;
                int v = getLCP(iSA[l1], iSA[l2]);
                if (v >= Math.min(len1, len2)) {
                    return Integer.compare(len1, len2);
                } else {
                    return Integer.compare(iSA[l1], iSA[l2]);
                }
            }
        });

        // Build rolling hash tables
        HashF[0] = 0;
        HashR[len + 1] = 0;
        for (int i = 1; i <= len; i++) {
            HashF[i] = (int) ((1L * HashF[i - 1] * PRIME + s[i - 1]) % MOD1);
            HashR[len - i + 1] = (int) ((1L * HashR[len - i + 2] * PRIME + s[len - i]) % MOD1);
        }

        long[] bs = new long[AIdx];
        int[] hashes = new int[AIdx];
        long v = 0;
        for (int i = 0; i < AIdx; i++) {
            v += A[i][2];
            bs[i] = v;
            hashes[i] = getForwardHash(A[i][0] + 1, A[i][1] + 1);
        }

        StringBuilder sb = new StringBuilder();
        for (int qi = 0; qi < q; qi++) {
            long k = in.nextLong();
            if (k > v) {
                sb.append("-1\n");
            } else {
                int ii = lowerBound(bs, 0, AIdx, k);
                sb.append(hashes[ii]).append("\n");
            }
        }
        System.out.print(sb);
    }

    // ---------- Palindromic tree ----------
    static void initTree() {
        pNumNodes = 2;
        suff = 2;
        pLen[1] = -1;
        pSufflink[1] = 1;
        pLen[2] = 0;
        pSufflink[2] = 1;
        pNum[1] = 0;
        pNum[2] = 0;
    }

    static void addLetter(int pos) {
        int cur = suff;
        int let = s[pos] - 'a';
        while (true) {
            int curlen = pLen[cur];
            if (pos - 1 - curlen >= 0 && s[pos - 1 - curlen] == s[pos]) break;
            cur = pSufflink[cur];
        }
        if (pNext[cur][let] != 0) {
            suff = pNext[cur][let];
            pNum[suff]++;
            return;
        }
        pNumNodes++;
        suff = pNumNodes;
        pLen[pNumNodes] = pLen[cur] + 2;
        pR[pNumNodes] = pos;
        pL[pNumNodes] = pos - pLen[pNumNodes] + 1;
        pNext[cur][let] = pNumNodes;
        if (pLen[pNumNodes] == 1) {
            pSufflink[pNumNodes] = 2;
            pNum[pNumNodes] = 1;
            return;
        }
        pNum[pNumNodes]++;
        while (true) {
            cur = pSufflink[cur];
            int curlen = pLen[cur];
            if (pos - 1 - curlen >= 0 && s[pos - 1 - curlen] == s[pos]) {
                pSufflink[pNumNodes] = pNext[cur][let];
                break;
            }
        }
    }

    // ---------- Suffix array (doubling with counting sort + sentinel) ----------
    static void suffixSort() {
        int nn = len + 1;
        char[] t = new char[nn];
        System.arraycopy(s, 0, t, 0, len);
        t[len] = 0; // sentinel smaller than all letters

        int[] sa = new int[nn];
        int[] rank = new int[nn];
        int[] newRank = new int[nn];
        int[] tmp = new int[nn];
        int[] cnt = new int[Math.max(256, nn)];

        int ALPHA = 256;
        for (int i = 0; i < nn; i++) cnt[t[i]]++;
        for (int i = 1; i < ALPHA; i++) cnt[i] += cnt[i - 1];
        for (int i = nn - 1; i >= 0; i--) sa[--cnt[t[i]]] = i;

        rank[sa[0]] = 0;
        int classes = 1;
        for (int i = 1; i < nn; i++) {
            if (t[sa[i]] != t[sa[i - 1]]) classes++;
            rank[sa[i]] = classes - 1;
        }

        for (int h = 0; (1 << h) < nn; h++) {
            int shift = 1 << h;
            for (int i = 0; i < nn; i++) {
                tmp[i] = sa[i] - shift;
                if (tmp[i] < 0) tmp[i] += nn;
            }
            Arrays.fill(cnt, 0, classes, 0);
            for (int i = 0; i < nn; i++) cnt[rank[tmp[i]]]++;
            for (int i = 1; i < classes; i++) cnt[i] += cnt[i - 1];
            for (int i = nn - 1; i >= 0; i--) sa[--cnt[rank[tmp[i]]]] = tmp[i];

            newRank[sa[0]] = 0;
            classes = 1;
            for (int i = 1; i < nn; i++) {
                int cur1 = rank[sa[i]];
                int cur2 = rank[(sa[i] + shift) % nn];
                int prev1 = rank[sa[i - 1]];
                int prev2 = rank[(sa[i - 1] + shift) % nn];
                if (cur1 != prev1 || cur2 != prev2) classes++;
                newRank[sa[i]] = classes - 1;
            }
            System.arraycopy(newRank, 0, rank, 0, nn);
            if (classes == nn) break;
        }

        // sa[0] is the sentinel suffix; drop it
        for (int i = 0; i < len; i++) {
            SA[i] = sa[i + 1];
            iSA[SA[i]] = i;
        }
    }

    // ---------- LCP (Kasai) + sparse table ----------
    static void initLCP() {
        int h = 0;
        for (int i = 0; i < len; i++) {
            if (iSA[i] > 0) {
                int j = SA[iSA[i] - 1];
                while (i + h < len && j + h < len && s[i + h] == s[j + h]) h++;
                lcp[iSA[i]] = h;
                if (h > 0) h--;
            }
        }
    }

    static void constructLCP() {
        for (int i = 0; i < len; i++) LCP[i][0] = lcp[i];
        for (int j = 1; (1 << j) <= len; j++) {
            for (int i = 0; i + (1 << j) - 1 < len; i++) {
                LCP[i][j] = Math.min(LCP[i][j - 1], LCP[i + (1 << (j - 1))][j - 1]);
            }
        }
    }

    static int getLCP(int x, int y) {
        if (x == y) return len - SA[x];
        if (x > y) { int tmp = x; x = y; y = tmp; }
        int log = 0;
        while ((1 << (log + 1)) <= (y - x)) log++;
        return Math.min(LCP[x + 1][log], LCP[y - (1 << log) + 1][log]);
    }

    // ---------- Rolling hash ----------
    static int getForwardHash(int l, int r) {
        if (l == 1) return HashF[r];
        long val = HashF[r] - (1L * HashF[l - 1] * P[r - l + 1]) % MOD1;
        if (val < 0) val += MOD1;
        return (int) val;
    }

    static int lowerBound(long[] arr, int from, int to, long target) {
        int lo = from, hi = to;
        while (lo < hi) {
            int mid = (lo + hi) >>> 1;
            if (arr[mid] < target) lo = mid + 1;
            else hi = mid;
        }
        return lo;
    }

    // ---------- Fast input ----------
    static class FastReader {
        private static final int BUFFER_SIZE = 1 << 16;
        private InputStream din;
        private byte[] buffer;
        private int bufferPointer, bytesRead;

        FastReader(InputStream in) {
            din = in;
            buffer = new byte[BUFFER_SIZE];
            bufferPointer = bytesRead = 0;
        }

        private void fillBuffer() throws IOException {
            bytesRead = din.read(buffer, 0, BUFFER_SIZE);
            if (bytesRead == -1) buffer[0] = -1;
            bufferPointer = 0;
        }

        private byte read() throws IOException {
            if (bufferPointer == bytesRead) fillBuffer();
            return buffer[bufferPointer++];
        }

        String next() throws IOException {
            int cnt = 0;
            byte[] buf = new byte[100005];
            byte c = read();
            while (c <= ' ') c = read();
            do {
                buf[cnt++] = c;
                c = read();
            } while (c > ' ');
            return new String(buf, 0, cnt);
        }

        int nextInt() throws IOException {
            int ret = 0;
            byte c = read();
            while (c <= ' ') c = read();
            boolean neg = (c == '-');
            if (neg) c = read();
            do {
                ret = ret * 10 + c - '0';
            } while ((c = read()) >= '0' && c <= '9');
            return neg ? -ret : ret;
        }

        long nextLong() throws IOException {
            long ret = 0;
            byte c = read();
            while (c <= ' ') c = read();
            boolean neg = (c == '-');
            if (neg) c = read();
            do {
                ret = ret * 10 + c - '0';
            } while ((c = read()) >= '0' && c <= '9');
            return neg ? -ret : ret;
        }
    }
}
