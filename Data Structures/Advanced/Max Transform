import java.util.*;
import java.io.*;

public class Main {
    static final int P = 1000000007;
    static final int N = 1100000;

    static int[] used = new int[N];
    static int[] fa = new int[N];
    static int[] sum = new int[N];
    static long[] f = new long[N];
    static int now, ans, T, cc;
    static int n;
    static int[] a = new int[N];

    static BufferedReader br;
    static StringTokenizer st;

    static int readInt() throws IOException {
        while (st == null || !st.hasMoreTokens()) {
            String line = br.readLine();
            if (line == null) return 0;
            st = new StringTokenizer(line);
        }
        return Integer.parseInt(st.nextToken());
    }

    static int gf(int x) {
        if (fa[x] != x)
            fa[x] = gf(fa[x]);
        return fa[x];
    }

    static void merge(int x, int y) {
        x = gf(x);
        y = gf(y);
        sum[x] += sum[y];
        fa[y] = x;
    }

    static void add(int x) {
        used[x] = 1;
        sum[x] = 1;
        if (used[x - 1] == 1) {
            now = (int)((now - f[sum[gf(x - 1)]] + P) % P);
            merge(x, x - 1);
        }
        if (used[x + 1] == 1) {
            now = (int)((now - f[sum[gf(x + 1)]] + P) % P);
            merge(x, x + 1);
        }
        now = (int)((now + f[sum[gf(x)]]) % P);
        int L = sum[gf(1)];
        int R = sum[gf(n)];
        x = Math.min(R, L - 1);
        if (x <= 0) {
            cc = now;
            return;
        }
        cc = now;
        cc = (int)((cc + 1L * x * L * (R + 1)) % P);
        cc = (int)((cc - 1L * x * (x + 1) / 2 % P * (L + R + 1)) % P);
        cc = (int)((cc + 1L * x * (x + 1) * (2 * x + 1) / 6) % P);
        cc = (int)((cc + P) % P);
    }

    public static void main(String[] args) throws IOException {
        br = new BufferedReader(new InputStreamReader(System.in));
        n = readInt();

        int ma = 0;
        for (int i = 1; i <= n; i++) {
            a[i] = readInt();
            ma = Math.max(ma, a[i]);
        }

        ArrayList<Integer>[] V = new ArrayList[ma + 1];
        for (int i = 1; i <= n; i++) {
            if (V[a[i]] == null) V[a[i]] = new ArrayList<>();
            V[a[i]].add(i);
        }

        T = (int)(1L * n * (n + 1) / 2 % P);
        T = (int)(1L * T * (T + 1) / 2 % P);

        for (int i = 1; i <= n; i++)
            f[i] = (1L * i * (i + 1) * (2 * i + 1) / 6 + 1L * i * (i + 1) / 2) / 2 % P;

        for (int i = 1; i <= n; i++)
            fa[i] = i;
        now = 0;
        ans = 0;

        for (int i = 0; i < ma; i++) {
            if (V[i] != null) {
                for (int j = 0; j < V[i].size(); j++)
                    add(V[i].get(j));
            }
            ans = (int)((ans + T - cc) % P);
        }
        ans = (int)((ans + P) % P);
        System.out.println(ans);
    }
}
