import java.io.*;
import java.util.*;

public class Solution {
    static final int MAXN = 111111 + 5;
    static final int MOD = 100711433;
    static int n, R;
    static int[] tree = new int[MAXN];
    static int[] len = new int[MAXN];
    static int[] belong = new int[MAXN];
    static int[] idx = new int[MAXN];
    static int all;
    static int[] top = new int[MAXN];
    static int[] parent = new int[MAXN];
    static int[] size = new int[MAXN];
    static int[] dep = new int[MAXN];
    static int[] coef = new int[MAXN << 1];
    static int[] revCoef = new int[MAXN << 1];
    static int[] sum = new int[MAXN << 1];
    static int[] pw = new int[MAXN];
    static int modInv;
    static List<Integer>[] children;
    static int[] q = new int[MAXN];
    static boolean[] vis = new boolean[MAXN];

    @SuppressWarnings("unchecked")
    static void init() {
        children = new List[MAXN];
        for (int i = 0; i < MAXN; i++) children[i] = new ArrayList<>();
    }

    static int power(int a, int b) {
        long ret = 1;
        long aa = a % MOD;
        while (b > 0) {
            if ((b & 1) == 1) ret = ret * aa % MOD;
            aa = aa * aa % MOD;
            b >>= 1;
        }
        return (int) ret;
    }

    static int inv(int x) {
        return power(x, MOD - 2);
    }

    static int gpSum(int cnt, int a1) {
        return (int) ((long) a1 * ((pw[cnt] - 1 + MOD) % MOD) % MOD * modInv % MOD);
    }

    static int getId(int t, int l, int r) {
        return tree[t] + ((l + r) | (l != r ? 1 : 0));
    }

    static void up(int t, int l, int r) {
        int id = getId(t, l, r);
        if (l == r) return;
        int m = (l + r) >> 1;
        int lid = getId(t, l, m), rid = getId(t, m + 1, r);
        sum[id] = (sum[lid] + sum[rid]) % MOD;
    }

    static void build(int t, int l, int r) {
        int id = getId(t, l, r);
        coef[id] = 0;
        revCoef[id] = 0;
        sum[id] = 0;
        if (l == r) return;
        int m = (l + r) >> 1;
        build(t, l, m);
        build(t, m + 1, r);
        up(t, l, r);
    }

    static void mark(int t, int l, int r, int add, int revAdd) {
        int id = getId(t, l, r);
        coef[id] = (coef[id] + add) % MOD;
        revCoef[id] = (revCoef[id] + revAdd) % MOD;
        sum[id] = (sum[id] + gpSum(r - l + 1, add)) % MOD;
        sum[id] = (sum[id] + gpSum(r - l + 1, revAdd)) % MOD;
    }

    static void down(int t, int l, int r) {
        int id = getId(t, l, r);
        if (l == r) return;
        int m = (l + r) >> 1;
        mark(t, l, m, coef[id], (int) ((long) revCoef[id] * pw[r - m] % MOD));
        mark(t, m + 1, r, (int) ((long) coef[id] * pw[m - l + 1] % MOD), revCoef[id]);
        coef[id] = 0;
        revCoef[id] = 0;
    }

    static void cover(int t, int l, int r, int a, int b, int x, int revX) {
        if (r < a || l > b) return;
        int id = getId(t, l, r);
        if (coef[id] != 0 || revCoef[id] != 0) down(t, l, r);
        if (a <= l && r <= b) {
            mark(t, l, r, (int) ((long) x * pw[l - a] % MOD), (int) ((long) revX * pw[b - r] % MOD));
            return;
        }
        int m = (l + r) >> 1;
        cover(t, l, m, a, b, x, revX);
        cover(t, m + 1, r, a, b, x, revX);
        up(t, l, r);
    }

    static int queryST(int t, int l, int r, int a, int b) {
        if (r < a || l > b) return 0;
        int id = getId(t, l, r);
        if (coef[id] != 0 || revCoef[id] != 0) down(t, l, r);
        if (a <= l && r <= b) return sum[id];
        int m = (l + r) >> 1;
        return (queryST(t, l, m, a, b) + queryST(t, m + 1, r, a, b)) % MOD;
    }

    static void hld(int root, int cnt) {
        Arrays.fill(dep, -1);
        all = 0;
        int l = 0, r = 1;
        q[l] = root;
        dep[root] = 0;
        parent[root] = -1;
        while (l < r) {
            int u = q[l++];
            vis[u] = false;
            for (int i = 0; i < children[u].size(); i++) {
                int v = children[u].get(i);
                if (dep[v] == -1) {
                    q[r++] = v;
                    dep[v] = dep[u] + 1;
                    parent[v] = u;
                }
            }
        }
        for (int i = cnt - 1; i >= 0; i--) {
            int u = q[i], p = -1;
            size[u] = 1;
            for (int j = 0; j < children[u].size(); j++) {
                int v = children[u].get(j);
                if (vis[v]) {
                    size[u] += size[v];
                    if (p == -1 || size[v] > size[p]) p = v;
                }
            }
            if (p == -1) {
                belong[u] = all;
                top[all] = u;
                idx[u] = 0;
                len[all++] = 1;
            } else {
                belong[u] = belong[p];
                top[belong[u]] = u;
                idx[u] = len[belong[u]]++;
            }
            vis[u] = true;
        }
        tree[0] = 0;
        for (int i = 1; i < all; i++) {
            tree[i] = tree[i - 1] + 2 * len[i - 1] - 1;
        }
        for (int i = 0; i < all; i++) {
            build(i, 0, len[i] - 1);
        }
    }

    static void change(int a, int b, int x) {
        List<Integer> A = new ArrayList<>(), B = new ArrayList<>();
        while (belong[a] != belong[b]) {
            if (dep[top[belong[a]]] < dep[top[belong[b]]]) {
                B.add(b);
                b = parent[top[belong[b]]];
            } else {
                A.add(a);
                a = parent[top[belong[a]]];
            }
        }
        boolean aLower = dep[a] < dep[b];
        if (aLower) {
            B.add(b);
            A.add(0);
        } else {
            A.add(a);
            B.add(0);
        }
        int X = x;
        for (int i = 0; i < A.size(); i++) {
            if (i == A.size() - 1 && aLower) continue;
            int ai = A.get(i);
            int from = idx[ai];
            int to = (i == A.size() - 1) ? idx[b] : idx[top[belong[ai]]];
            cover(belong[ai], 0, len[belong[ai]] - 1, from, to, X, 0);
            X = (int) ((long) X * pw[to - from + 1] % MOD);
        }
        Collections.reverse(B);
        for (int i = 0; i < B.size(); i++) {
            if (i == 0 && !aLower) continue;
            int bi = B.get(i);
            int from = idx[bi];
            int to = (i == 0) ? idx[a] : idx[top[belong[bi]]];
            cover(belong[bi], 0, len[belong[bi]] - 1, from, to, 0, X);
            X = (int) ((long) X * pw[to - from + 1] % MOD);
        }
    }

    static int queryPath(int a, int b) {
        int res = 0;
        while (belong[a] != belong[b]) {
            if (dep[top[belong[a]]] < dep[top[belong[b]]]) {
                res = (res + queryST(belong[b], 0, len[belong[b]] - 1, idx[b], idx[top[belong[b]]])) % MOD;
                b = parent[top[belong[b]]];
            } else {
                res = (res + queryST(belong[a], 0, len[belong[a]] - 1, idx[a], idx[top[belong[a]]])) % MOD;
                a = parent[top[belong[a]]];
            }
        }
        if (dep[a] < dep[b]) {
            res = (res + queryST(belong[a], 0, len[belong[a]] - 1, idx[b], idx[a])) % MOD;
        } else {
            res = (res + queryST(belong[a], 0, len[belong[a]] - 1, idx[a], idx[b])) % MOD;
        }
        return res;
    }

    static class FastScanner {
        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
        StringTokenizer st;

        String next() throws IOException {
            while (st == null || !st.hasMoreTokens()) {
                String line = br.readLine();
                if (line == null) return null;
                st = new StringTokenizer(line);
            }
            return st.nextToken();
        }

        Integer nextInt() throws IOException {
            String s = next();
            if (s == null) return null;
            return Integer.parseInt(s);
        }
    }

    public static void main(String[] args) throws IOException {
        init();
        FastScanner fs = new FastScanner();
        StringBuilder sb = new StringBuilder();
        while (true) {
            Integer nObj = fs.nextInt();
            if (nObj == null) break;
            n = nObj;
            R = fs.nextInt();

            pw[0] = 1;
            for (int i = 1; i <= n; i++) {
                pw[i] = (int) ((long) pw[i - 1] * R % MOD);
            }
            modInv = inv((R - 1 + MOD) % MOD);

            for (int i = 0; i < n; i++) children[i].clear();

            for (int i = 0; i < n - 1; i++) {
                int x = fs.nextInt() - 1;
                int y = fs.nextInt() - 1;
                children[x].add(y);
                children[y].add(x);
            }

            hld(0, n);

            int U = fs.nextInt();
            int Q = fs.nextInt();
            for (int i = 0; i < U; i++) {
                int u = fs.nextInt() - 1;
                int v = fs.nextInt() - 1;
                int x = fs.nextInt();
                change(u, v, x);
            }
            for (int i = 0; i < Q; i++) {
                int u = fs.nextInt() - 1;
                int v = fs.nextInt() - 1;
                sb.append(queryPath(u, v)).append('\n');
            }
        }
        System.out.print(sb);
    }
}
