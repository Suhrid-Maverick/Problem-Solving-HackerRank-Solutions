import java.io.*;
import java.util.*;

public class Solution {

    public static long solve(int[] arr) {
        int n = arr.length;
        int[] left = new int[n];
        int[] right = new int[n];

        for (int i = 0; i < n; i++) {
            // left part
            if (i == 0) {
                left[i] = 0;
            } else {
                if (arr[i] < arr[i - 1]) {
                    left[i] = i;
                } else {
                    left[i] = 0;
                }
            }

            // right part
            if (i == n - 1) {
                right[i] = 0;
            } else {
                if (arr[i] < arr[i + 1]) {
                    right[i] = i + 2;
                } else {
                    right[i] = 0;
                }
            }
        }

        long maxVal = Long.MIN_VALUE;
        for (int i = 0; i < n; i++) {
            long val = (long) left[i] * right[i];
            if (val > maxVal) {
                maxVal = val;
            }
        }
        return maxVal;
    }

    public static void main(String[] args) throws IOException {
        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
        // Example input reading (adjust as needed for the platform)
        int n = Integer.parseInt(br.readLine().trim());
        int[] arr = new int[n];
        StringTokenizer st = new StringTokenizer(br.readLine());
        for (int i = 0; i < n; i++) {
            arr[i] = Integer.parseInt(st.nextToken());
        }
        System.out.println(solve(arr));
    }
}
