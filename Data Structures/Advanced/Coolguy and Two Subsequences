import java.util.*;
import java.io.*;

public class Main {
    static final long M = 1000000007L;
    static final long inv2 = (M + 1) / 2;
    static final long inv6 = modpow(6, M - 2, M);

    public static void main(String[] args) throws IOException {
        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
        int N = Integer.parseInt(br.readLine().trim());
        long[] A = new long[N];
        StringTokenizer st = new StringTokenizer(br.readLine());
        for (int i = 0; i < N; i++) A[i] = Long.parseLong(st.nextToken());

        Integer[] order = new Integer[N];
        for (int i = 0; i < N; i++) order[i] = i;
        Arrays.sort(order, (x, y) -> Long.compare(A[x], A[y]));

        ArrayList<long[]> segs = new ArrayList<>();
        segs.add(new long[]{0, N - 1});

        long total = 0;
        long all_tri = tri(N);

        for (int o = 0; o < N; o++) {
            int ind = order[o];
            long val = A[ind];

            int si = findSegment(segs, ind);
            long first = segs.get(si)[0];
            long last = segs.get(si)[1];
            long seg_len = last - first + 1;
            long seg_tri = tri(seg_len);
            long to_left = ind - first;
            long to_right = last - ind;
            long ext_tri = ((all_tri - seg_tri) % M + M) % M;

            long weight = worth(to_left, to_right, ext_tri);
            long value = weight * (val % M) % M;
            total = (total + value) % M;

            updateSegments(segs, si, first, last, ind);
            all_tri = ((all_tri - seg_tri + tri(to_left) + tri(to_right)) % M + M) % M;
        }

        System.out.println(total);
    }

    static int findSegment(ArrayList<long[]> segs, long ind) {
        int lo = 0, hi = segs.size();
        while (lo < hi) {
            int mid = (lo + hi) >>> 1;
            if (ind < segs.get(mid)[0]) hi = mid;
            else lo = mid + 1;
        }
        return lo - 1;
    }

    static void updateSegments(ArrayList<long[]> segs, int si, long first, long last, long ind) {
        if (ind == first) {
            segs.set(si, new long[]{first + 1, last});
        } else if (ind == last) {
            segs.set(si, new long[]{first, last - 1});
        } else {
            segs.set(si, new long[]{first, ind - 1});
            segs.add(si + 1, new long[]{ind + 1, last});
        }
    }

    static long tri(long x) {
        long a = x % M;
        long b = (x + 1) % M;
        return a * b % M * inv2 % M;
    }

    static long tri6(long x) {
        long a = x % M;
        long b = (x + 1) % M;
        long c = (x + 2) % M;
        return a * b % M * c % M * inv6 % M;
    }

    static long worth(long m, long n, long ext_tri) {
        long n_sum = tri6(n);
        long m_sum = tri6(m);
        long e_sum = ext_tri * ((n + 1) % M) % M * ((m + 1) % M) % M;
        long r1 = ((n + 1) % M) * m_sum % M;
        long r2 = ((m + 1) % M) * n_sum % M;
        return (r1 + r2 + e_sum) % M;
    }

    static long modpow(long b, long e, long m) {
        long r = 1;
        b %= m;
        while (e > 0) {
            if ((e & 1) == 1) r = r * b % m;
            b = b * b % m;
            e >>= 1;
        }
        return r;
    }
}
