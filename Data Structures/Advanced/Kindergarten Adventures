import java.util.Scanner;

public class Solution {

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int[] brr = new int[n];
        int[] arr = new int[n];

        for (int i = 0; i < n; i++) {
            arr[i] = sc.nextInt();
        }

        for (int i = 0; i < n; i++) {
            if (arr[i] > n - 1 || arr[i] == 0) {
                continue;
            }
            brr[(i + 1) % n]++;
            brr[((i + 1 + n) - arr[i]) % n]--;
        }

        int[] crr = new int[n];
        crr[0] = brr[0];

        for (int i = 1; i < n; i++) {
            crr[i] = crr[i - 1] + brr[i];
        }

        int max = 0;
        for (int i = 1; i < n; i++) {
            if (crr[i] > crr[max]) {
                max = i;
            }
        }

        System.out.println(max + 1);

        sc.close();
    }
}
